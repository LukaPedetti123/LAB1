.include "m328Pdef.inc"
                              ;Planifique una estructura general, ahora tengo que implementarlo en codigo
.org 0x0000
   rjmp RESET

RESET:
   ;Entradas y salidas
ldi r16, (1<<PB0) | (1<<PB1) | (1<<PB2) | (1<<PB3) | (1<<PB4)
out DDRB, r16

cbi DDRD, 2
sbi PORTD, 3

clr r17
rjmp ESPERAR_Soltar

Luces:  ;Evaluca que luz encender

   cbi PORTB, PB2
   cbi PORTB, PB3
   cbi PORTB, PB4

   cbi r17, 0
   breq Ligera ;Ligera

   cbi r17, 1 
   breq, Media

   cbi r17, 2
   breq Pesada

Ligera:
   sbi PORTB, PB2
   ret

Media:
   sbi PORTB, PB3
   ret

Pesada:
   sbi PORTB, PB4
   ret

Esperar_Soltar:
   rcall Luces
   ESPERAR_SOLO:
   sbi PORTB, PB0
   sbis PIND, 2
   rjmp ESPERAR_SOLO

ESPERAR_RESIONAR:
sbis PIND, 3
rjmp Lavado      ;Empiesa el proceso prinsipal
sbis PIND, 2
rjmp More1       ;n+1
rjmp ESPERAR_PRESIONAR

More1:

